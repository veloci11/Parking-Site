{
  "name": "gp-parking",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:connected": "GP_FORCE_LOCAL_DEMO=false GP_DIST_DIR=.next-connected NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001 next dev --hostname 127.0.0.1 --port 3001",
    "format:check": "prettier --check src scripts tests next.config.ts package.json tsconfig.json",
    "preview:demo": "GP_FORCE_LOCAL_DEMO=true GP_LOCAL_DEMO=true NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000 next start --hostname 127.0.0.1 --port 3000",
    "preview:connected": "GP_FORCE_LOCAL_DEMO=false NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001 next start --hostname 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.0.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "three": "^0.182.0",
    "yazl": "3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@types/yazl": "3.3.1",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
