# Live backend: fill these from your own Supabase project. No service-role key required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local-only fictitious inventory and accounts. NEVER enable on a public host.
GP_FORCE_LOCAL_DEMO=false
# Keep false until operator details, policies, real inventory and launch checks are complete.
GP_PUBLIC_LAUNCH=false
GP_PUBLIC_SHOWCASE=false
# Optional map style URL. Attribution must be retained.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Local demo data path (ignored by Git), optional.
# GP_DATABASE_PATH=.data/gp-demo.sqlite

# Canonical origin used for CSRF and Auth callbacks; configure matching Supabase redirect URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# Complementary application check; migration 025 requires moderator/admin AAL2 in the database.
# Operators must enroll and verify their authenticator before privileged access.
GP_REQUIRE_ADMIN_MFA=true

# Server-only random secret (at least 32 characters) for signed Auth return/recovery grants.
# Required for connected registration and recovery. Never expose as NEXT_PUBLIC_.
GP_AUTH_FLOW_SECRET=
