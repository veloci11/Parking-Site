[Unit]
Description=GP park web application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/gp-park/current
EnvironmentFile=%h/gp-park/shared/production.env
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=%h/gp-park/runtime/node/bin/node %h/gp-park/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3010
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
MemoryMax=2G
TasksMax=512
Nice=10

[Install]
WantedBy=default.target
