  "selection": {
    "filterBackground": "accentSoft",
    "filterBorder": "accentBorder",
    "filterText": "textPrimary",
    "floorFill": "accent",
    "floorFillOpacity": 0.22,
    "floorOutline": "brand",
    "mapMarkerBackground": "accentSoft",
    "mapMarkerOutline": "brand",
    "noGoldPrimaryButtons": true
