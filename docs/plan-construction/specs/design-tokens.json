  "layout": {
    "editorialMaxPx": 1280,
    "headerDesktopPx": 76,
    "headerMobilePx": 64,
    "resultsMinPx": 320,
    "resultsMaxPx": 400,
    "inspectorMinPx": 320,
    "inspectorMaxPx": 360,
