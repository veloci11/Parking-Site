{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gp:listing-submission:1.0",
  "title": "Commande de soumission complete, pas schema des brouillons incomplets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revisionId",
    "expectedVersion",
    "clientRequestId",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revisionId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1
    },
    "clientRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "saleMode",
        "spaceCount",
        "totalPriceCents",
        "currency",
        "propertyType",
        "location",
        "units",
        "publicPhotoIds",
        "occupancy",
        "qualityAnswered",
        "publicationRightsAttested"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 15,
          "maxLength": 90
        },
        "description": {
          "type": "string",
          "minLength": 100,
          "maxLength": 5000
        },
        "saleMode": {
          "enum": [
            "single_space",
            "bundle"
          ]
        },
        "spaceCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "totalPriceCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000
        },
        "currency": {
          "const": "EUR"
        },
        "propertyType": {
          "enum": [
            "indoor_parking",
            "outdoor_parking",
            "closed_garage",
            "mixed_bundle"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city",
            "postalCode",
            "addressPrivate",
            "exactCoordinates",
            "publicPrecision",
            "exactLocationConsent"
          ],
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "postalCode": {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            "addressPrivate": {
              "type": "string",
              "minLength": 5,
              "maxLength": 300
            },
            "exactCoordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "items": false
            },
            "publicPrecision": {
              "enum": [
                "area",
                "exact_opt_in"
              ]
            },
            "exactLocationConsent": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "publicPrecision": {
                    "const": "exact_opt_in"
                  }
                }
              },
              "then": {
                "properties": {
                  "exactLocationConsent": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clientUnitId",
              "spaceId",
              "displayNumber",
              "level",
              "areaM2",
              "widthMm",
              "lengthMm",
              "clearanceMm",
              "dimensionSource"
            ],
            "properties": {
              "clientUnitId": {
                "type": "string",
                "format": "uuid"
              },
              "spaceId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "displayNumber": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 40
              },
              "level": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "areaM2": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "widthMm": {
                "type": [
                  "integer",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "lengthMm": {
                "type": [
                  "integer",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "clearanceMm": {
                "type": [
                  "integer",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "dimensionSource": {
                "enum": [
                  "unknown",
                  "seller_declared",
                  "plan_derived",
                  "measured"
                ]
              },
              "unitPhotoIds": {
                "type": "array",
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "publicPhotoIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "occupancy": {
          "enum": [
            "vacant",
            "occupied",
            "unknown"
          ]
        },
        "qualityAnswered": {
          "const": true
        },
        "publicationRightsAttested": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "saleMode": {
                "const": "single_space"
              }
            }
          },
          "then": {
            "properties": {
              "spaceCount": {
                "const": 1
              },
              "units": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "saleMode": {
                "const": "bundle"
              }
            }
          },
          "then": {
            "properties": {
              "spaceCount": {
                "minimum": 2
              },
              "units": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
