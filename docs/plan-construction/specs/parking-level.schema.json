{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gp:parking-level:1.0",
  "title": "Manifest public assaini de niveau de parking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "parkingId",
    "levelId",
    "sceneVersion",
    "isDemo",
    "fidelity",
    "status",
    "coordinates",
    "scale",
    "camera",
    "spaces",
    "observations",
    "assets",
    "publicLocationContext"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "parkingId": {
      "type": "string",
      "format": "uuid"
    },
    "levelId": {
      "type": "string",
      "format": "uuid"
    },
    "sceneVersion": {
      "type": "integer",
      "minimum": 1
    },
    "isDemo": {
      "type": "boolean"
    },
    "fidelity": {
      "enum": [
        "schematic",
        "measured",
        "reviewed"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "retired"
      ]
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "handedness",
        "upAxis",
        "origin"
      ],
      "properties": {
        "unit": {
          "const": "m"
        },
        "handedness": {
          "const": "right"
        },
        "upAxis": {
          "const": "Y"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrated",
        "controlDistancesCount",
        "accuracyM",
        "publicSourceSummary"
      ],
      "properties": {
        "calibrated": {
          "type": "boolean"
        },
        "controlDistancesCount": {
          "type": "integer",
          "minimum": 0
        },
        "accuracyM": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "publicSourceSummary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        }
      }
    },
    "observedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spaceId",
          "displayNumber",
          "meshName",
          "footprintXZ",
          "dimensions",
          "source"
        ],
        "properties": {
          "spaceId": {
            "type": "string",
            "format": "uuid"
          },
          "displayNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "meshName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "footprintXZ": {
            "type": "array",
            "minItems": 3,
            "maxItems": 100,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lengthM",
              "widthM",
              "clearanceM"
            ],
            "properties": {
              "lengthM": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "widthM": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "clearanceM": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              }
            }
          },
          "source": {
            "enum": [
              "schematic",
              "plan_derived",
              "measured"
            ]
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "description",
          "source",
          "observedAt",
          "publicEvidenceMediaIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "spaceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "category": {
            "enum": [
              "floor",
              "wall",
              "humidity",
              "lighting",
              "markings",
              "maneuvering",
              "clearance",
              "access",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "enum": [
              "seller_declared",
              "photo_documented",
              "measured",
              "plan_derived"
            ]
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "publicEvidenceMediaIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "previewKey"
      ],
      "properties": {
        "modelKey": {
          "type": "string",
          "pattern": "^published-scenes/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(glb|json)$"
        },
        "previewKey": {
          "type": "string",
          "pattern": "^published-scenes/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(png|webp)$"
        },
        "plan2dKey": {
          "type": "string",
          "pattern": "^published-scenes/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.json$"
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicLocationContext": {
      "const": "exact_opt_in"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fidelity": {
            "enum": [
              "measured",
              "reviewed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scale": {
            "properties": {
              "calibrated": {
                "const": true
              },
              "controlDistancesCount": {
                "minimum": 2
              },
              "accuracyM": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fidelity": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "required": [
          "reviewedAt"
        ],
        "properties": {
          "reviewedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
